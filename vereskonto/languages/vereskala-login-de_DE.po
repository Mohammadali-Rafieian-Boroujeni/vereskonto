msgstr "%d aktive Kreditpläne"

msgid "%d installments"
msgstr "%d Raten"

msgid "%d instalment credit plans were restored — their orders never completed payment."
msgstr "%d Ratenkredit-Pläne wurden wiederhergestellt — ihre Bestellungen haben die Zahlung nie abgeschlossen."

msgid "%d log rows removed."
msgstr "%d Protokollzeilen entfernt."

msgid "%d points converted to wallet credit."
msgstr "%d Punkte in Wallet-Guthaben umgewandelt."

msgid "%d repayment or top-up orders were moved out of the sales figures."
msgstr "%d Rückzahlungs- oder Aufladebestellungen wurden aus den Umsatzzahlen genommen."

msgid "%s app sessions signed out."
msgstr "%s App-Sitzungen abgemeldet."

msgid "%s carts in this view"
msgstr "%s Warenkörbe in dieser Ansicht"

msgid "%s inactive carts deleted."
msgstr "%s inaktive Warenkörbe gelöscht."

msgid "%s members with points"
msgstr "%s Mitglieder mit Punkten"

